{
  "name": "docfilly",
  "version": "0.2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/docfilly.cjs",
  "module": "./dist/docfilly.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/docfilly.js",
      "require": "./dist/docfilly.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "vite build --watch"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "typescript": "^5.8.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "marked": "^18.0.11"
  }
}

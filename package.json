{
  "name": "docfilly-monorepo",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @docfilly/web dev",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "generate:icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @docfilly/web test:e2e",
    "test:watch": "pnpm -r --parallel test:watch",
    "typecheck": "pnpm -r typecheck",
    "version:check": "node scripts/check-version-sync.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "typescript-eslint": "8.67.0"
  }
}
